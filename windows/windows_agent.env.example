# Environment for plan_agent/windows_agent.py on the always-on Windows laptop.
#
# Copy this file to a location OUTSIDE the git repository (e.g. C:\ShturmanAgent\agent.env),
# fill in real values, and pass its path to install_task_scheduler.ps1 / install_nssm_service.ps1
# with -EnvFile. Those scripts set these as persistent Windows environment variables for the
# dedicated service account — the values are never written into a scheduled task, a service
# definition, or any file this repository tracks. Never commit a filled-in copy of this file.

# --- Railway (or wherever the Штурман server is deployed) ---------------------------------------
# Base URL of the Штурман server. Used both by this script's own job-queue calls and, unchanged,
# by plan_agent's own HTTP client for writing project data (docs/EXTERNAL_AGENT.md).
PM_API_URL=https://your-app.up.railway.app

# The EXISTING agent credential (same one Railway's AGENT_API_KEY is set to). plan_agent's own
# client uses this; it is NOT the job-queue credential below.
PM_AGENT_API_KEY=

# A SEPARATE credential, only for the job-queue endpoints (/api/agent-jobs/*). Must match Railway's
# WINDOWS_AGENT_API_KEY exactly. Generate with: openssl rand -hex 32 (or
# [System.Web.Security.Membership]::GeneratePassword(48,0) in PowerShell).
WINDOWS_AGENT_API_KEY=

# --- The corporate workbook (read on THIS machine only; never sent anywhere but Railway's API) --
# Either a fixed path to the file:
WINDOWS_AGENT_WORKBOOK_PATH=\\corp-fileserver\Planning\engineering_plan.xlsx
# ...or, if the file name changes (e.g. a new copy each month), a folder + glob pattern instead
# (the newest match is used). Leave WORKBOOK_PATH empty to use this instead:
# WINDOWS_AGENT_WORKBOOK_FOLDER=\\corp-fileserver\Planning
# WINDOWS_AGENT_WORKBOOK_PATTERN=*.xlsx

# --- Tuning (defaults are reasonable; override only if you have a specific reason) --------------
# PLAN_TARGET_MONTH=auto
# WINDOWS_AGENT_POLL_SECONDS=20
# WINDOWS_AGENT_SETTLE_SECONDS=5
# WINDOWS_AGENT_READ_ATTEMPTS=6
# WINDOWS_AGENT_RETRY_SECONDS=10
# WINDOWS_AGENT_HEARTBEAT_SECONDS=60
# WINDOWS_AGENT_HTTP_TIMEOUT=30
# WINDOWS_AGENT_CLI_TIMEOUT_SECONDS=600

# --- Where this machine keeps its own state (state, logs, single-instance lock) -----------------
# Pick a real folder outside the repo if you installed the repo somewhere that gets `git pull`ed
# over; the approved mapping (state/mapping.approved.yaml) must survive updates and restarts.
# PLAN_AGENT_STATE_DIR=C:\ShturmanAgent\state
# WINDOWS_AGENT_LOG_DIR=C:\ShturmanAgent\state\logs
# WINDOWS_AGENT_LOCK_FILE=C:\ShturmanAgent\state\windows_agent.lock

# Leave at the default (unset = enabled): a `sync` only writes after verify-deployment reports the
# Railway server READY. Only set this to 0 if you specifically need to bypass that check.
# PLAN_AGENT_REQUIRE_VERIFIED_DEPLOYMENT=1
