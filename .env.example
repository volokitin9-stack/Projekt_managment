# Copy this file to .env and fill in real values. Never commit .env.

# Port the HTTP server listens on.
PORT=3000

# Where the SQLite database file lives. Point this at a persistent volume/disk
# on your hosting platform — many platforms wipe the local filesystem on
# redeploy, which would otherwise silently discard all data.
DATABASE_PATH=./data/app.sqlite

# Where uploaded images/attachments are stored on disk (see server/storage.js).
# Same persistence note as above applies.
UPLOADS_DIR=./uploads

# Shared secret the external AI agent must send as "Authorization: Bearer <key>"
# on every /api/agent/* request. Required — agent endpoints are disabled (501)
# until this is set. Generate a long random value, e.g.: openssl rand -hex 32
AGENT_API_KEY=

# Comma-separated list of origins allowed to call the API from a browser other
# than the one serving public/ (CORS). Leave blank if the dashboard is always
# served by this same server.
CORS_ORIGINS=

# Max upload size per file, in bytes. Default: 10 MB.
MAX_UPLOAD_BYTES=10485760
