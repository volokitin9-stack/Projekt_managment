# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Штурман application (Node/Express)
# ---------------------------------------------------------------------------
# Port the HTTP server listens on.
PORT=3000

# Folder of the JSON data file (data/shturman.json), its backups and run reports.
# Point this at a persistent volume/disk on your hosting platform — many
# platforms wipe the local filesystem on redeploy, which would otherwise
# silently discard all data.
DATA_DIR=./data

# Where uploaded images/attachments are stored on disk (see server/storage.js).
# Same persistence note as above applies.
UPLOADS_DIR=./uploads

# Shared secret the external AI agent must send as "Authorization: Bearer <key>"
# on every /api/agent/* request. Required — agent endpoints are disabled (501)
# until this is set. Generate a long random value, e.g.: openssl rand -hex 32
AGENT_API_KEY=

# Comma-separated list of origins allowed to call the API from a browser other
# than the one serving public/ (CORS). Leave blank if the dashboard is always
# served by this same server.
CORS_ORIGINS=

# Max upload size per file, in bytes. Default: 10 MB.
MAX_UPLOAD_BYTES=10485760

# Insert the 14 demonstration projects into an EMPTY data file on start.
# Leave false for any real (production) data. Development only.
SEED_DEMO_DATA=false

# ---------------------------------------------------------------------------
# Planning-file import (manual Excel upload in the dashboard)
# ---------------------------------------------------------------------------
# Where uploaded planning files and the agent's state (reports, approved
# mapping, review queue) are kept. NOT served over HTTP. Keep it persistent.
PLAN_IMPORT_DIR=./data/plan-imports
# Python interpreter that runs the planning agent (python -m plan_agent).
PLAN_AGENT_PYTHON=python3
# Max size of an uploaded planning file, in bytes. Default: 50 MB.
MAX_PLAN_UPLOAD_BYTES=52428800

# ---------------------------------------------------------------------------
# Automatic plan retrieval (see docs/FILE_SOURCE.md)
# ---------------------------------------------------------------------------
# Source type. Only "local" is implemented (a file or folder on this server;
# a mounted network share counts as local). Empty = monitoring off.
PLAN_SOURCE_TYPE=local
# File, or folder holding exactly one planning file. A relative path is
# resolved against the application folder. Empty = monitoring off.
PLAN_SOURCE_PATH=
# Optional file-name pattern in folder mode, e.g. AfM__ISOEM_*.xlsx
PLAN_SOURCE_PATTERN=
# Minutes between checks.
PLAN_CHECK_INTERVAL_MINUTES=30
# false (default): new versions are analysed and WAIT for approval in «Импорт плана».
# true: safe changes (hours, existing activities, approved fields) are applied
# automatically; everything else goes to review. Can be switched in the UI.
PLAN_AUTO_SYNC_ENABLED=false
# Reporting month: auto (current month in PLAN_TIMEZONE) or YYYY-MM.
PLAN_TARGET_MONTH=auto
# Time zone that decides the current month.
PLAN_TIMEZONE=Europe/Moscow
# A file is read only after it has not changed for this many seconds.
PLAN_SOURCE_SETTLE_SECONDS=5
# First check after start-up, in seconds.
PLAN_SOURCE_INITIAL_DELAY_SECONDS=15

# ---------------------------------------------------------------------------
# Planning agent (Python) - only needed when the agent runs outside the app,
# e.g. from the command line. Inside the app these are set automatically.
# ---------------------------------------------------------------------------
# PM_API_URL=http://127.0.0.1:3000
# PM_AGENT_API_KEY=<same value as AGENT_API_KEY>
# PLAN_AGENT_STATE_DIR=./data/plan-imports/state
# PLAN_AGENT_REQUIRE_VERIFIED_DEPLOYMENT=1
