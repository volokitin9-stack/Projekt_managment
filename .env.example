# Dashboard API (Projekt_managment backend)
PM_API_URL=http://127.0.0.1:8080
# Shared secret for /api/agent/* - set the SAME value on the backend.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PM_AGENT_API_KEY=
# Optional
PM_API_TIMEOUT=20
PM_API_MAX_RETRIES=4
PLAN_AGENT_STATE_DIR=./state
PLAN_AGENT_CONFIG_DIR=./config
# HTTP intake for other agents (plan_agent serve)
PLAN_AGENT_INTAKE_KEY=
PLAN_AGENT_HOST=127.0.0.1
PLAN_AGENT_PORT=8090
# Reference backend
PM_DB_PATH=./data/projekt.db
PM_PORT=8080
